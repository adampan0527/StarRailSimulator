{
  "name": "star-rail-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.13.1",
    "npm": "11.14.1"
  },
  "packageManager": "npm@11.14.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "npm run typecheck && vite build",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run format:check && npm run lint && npm run test && npm run build",
    "predesktop:dev": "node scripts/prepare-archiver.mjs",
    "desktop:dev": "tauri dev --target x86_64-pc-windows-msvc -- --locked",
    "predesktop:build": "node scripts/prepare-archiver.mjs",
    "desktop:build": "tauri build --target x86_64-pc-windows-msvc --no-bundle -- --locked",
    "roadmap:check": "node \"html_report/01_开发路线图/build.mjs\" --check"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "ajv": "8.18.0",
    "eslint": "10.15.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8",
    "xxhash-wasm": "1.1.0"
  }
}
